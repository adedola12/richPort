# --- core ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/richport
PORT=4000
JWT_SECRET=change-me
# JWT_EXPIRES_IN=48h            # optional, default 48h
CORS_ORIGINS=https://rich-port.vercel.app,http://localhost:5173
JSON_LIMIT=2mb
# NODE_ENV=production

# --- cloudinary (existing uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# GFX_IMAGE_MAX_MB=10           # optional, default 10
# UI_IMAGE_MAX_MB=10            # optional, default 10

# --- booking emails (POST /api/questionnaire) ---
# Provider: "gmail" (Nodemailer + Gmail App Password) or "resend"
MAIL_PROVIDER=gmail
GMAIL_USER=des.richardenoch@gmail.com
# Create at https://myaccount.google.com/apppasswords (requires 2FA on the des account)
GMAIL_APP_PASSWORD=
# Only needed when MAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=

# Where "NEW BOOKING" notifications are delivered
# (optional — defaults to des.richardenoch@gmail.com)
OWNER_EMAIL=des.richardenoch@gmail.com
